# .dockerignore for the commit-image build.
# Bake in the FULL repo (including .git history — the grader/PATCH tier use it), dropping only local
# build artifacts and editor/OS cruft. This is a dev image, not a minimal one. .git is KEPT.

# ── Build outputs / local cruft ──────────────────────────────────────────────
.objs/
bin/
src/dasm
src/ftohex
src/test_errors
src/test_util
*.o
*.a
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
